# Dependencies
node_modules/
**/node_modules/

# Environment files and secrets (NEVER commit secrets to Git)
.env
.env.*
!.env.example
*.env.local

# Production build artifacts
dist/
build/
**/dist/
**/dist-ssr/

# Runtime uploads and user-generated media
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
**/uploads/*

# System & OS garbage
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and caches
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
